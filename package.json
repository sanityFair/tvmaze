{
  "name": "tvmaze",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @tvmaze/web --filter @tvmaze/api dev",
    "dev:web": "pnpm --filter @tvmaze/web dev",
    "dev:api": "pnpm --filter @tvmaze/api dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @tvmaze/api start",
    "preview": "pnpm --filter @tvmaze/web preview",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.90.0"
  },
  "packageManager": "pnpm@10.26.0"
}
