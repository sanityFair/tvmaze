{
  "name": "tvmaze",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @tvmaze/web --filter @tvmaze/api dev",
    "dev:web": "pnpm --filter @tvmaze/web dev",
    "dev:api": "pnpm --filter @tvmaze/api dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @tvmaze/api start",
    "preview": "pnpm --filter @tvmaze/web preview",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:deps": "depcruise apps/web/src apps/api/src packages/contracts/src --config .dependency-cruiser.cjs",
    "deps:graph": "depcruise apps/web/src --config .dependency-cruiser.cjs --include-only \"^apps/web/src/app\" --collapse \"^apps/web/src/app/main-page/(show-search-page|favorite-page|main-header|components)/[^/]+/|^apps/web/src/app/(main-page/logic|logic)/tasks/|^apps/web/src/app/(login-page|backdrop-side)/|^apps/web/src/app/components/[^/]+/\" -T mermaid --output-to deps-graph.mmd",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm typecheck && pnpm lint && pnpm lint:deps && pnpm format:check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@swc/core": "^1.16.22",
    "dependency-cruiser": "^18.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.90.0"
  },
  "packageManager": "pnpm@10.26.0"
}
